prefix_rule(pattern=[".venv/bin/python", "-m", "pip", "install"], decision="allow")
prefix_rule(pattern=["pgrep", "-fl"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "print(hs.json.encode({configDir=hs.configDir,accessibility=hs.accessibilityState(false),activeHotkeys=hs.hotkey.getHotkeys(),status=spaceNumberStatus}))"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "print(hs.accessibilityState(false))"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "local screens={}; for _,s in ipairs(hs.screen.allScreens()) do table.insert(screens,{name=s:name(),id=s:id(),uuid=s:getUUID()}) end; print(hs.json.encode({screens=screens,separate=hs.spaces.screensHaveSeparateSpaces(),focused=hs.spaces.focusedSpace(),focusedDisplay=hs.spaces.spaceDisplay(hs.spaces.focusedSpace()),spaces=hs.spaces.allSpaces()}))"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "hs.reload()"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "local ax=hs.axuielement; local out={focused=hs.spaces.focusedSpace(),apps={}}; for _,bundle in ipairs({\"com.apple.WindowManager\",\"com.apple.dock\",\"com.apple.finder\",\"com.apple.wallpaper\"}) do local app=hs.application.applicationsForBundleID(bundle)[1]; local item={bundle=bundle}; if app then item.pid=app:pid(); item.children={}; for _,e in ipairs(ax.applicationElement(app):attributeValue(\"AXChildren\") or {}) do table.insert(item.children,{role=e:attributeValue(\"AXRole\"),identifier=e:attributeValue(\"AXIdentifier\"),title=e:attributeValue(\"AXTitle\"),children=#(e:attributeValue(\"AXChildren\") or {})}) end end; table.insert(out.apps,item) end; print(hs.json.encode(out))"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "hs.eventtap.keyStroke({\"ctrl\",\"alt\",\"shift\",\"cmd\"}, \"1\", 0); hs.timer.doAfter(3, function() hs.screen.mainScreen():shotAsPNG(\"/private/tmp/codex-space-desktop.png\"); print(hs.json.encode({status=spaceNumberStatus,focused=hs.spaces.focusedSpace()})) end)"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "hs.screen.mainScreen():shotAsPNG(\"/private/tmp/codex-space-desktop.png\"); print(hs.json.encode({focused=hs.spaces.focusedSpace(),wallpaper=hs.screen.mainScreen():desktopImageURL()}))"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "spaceDiagnosticTimer=hs.timer.doAfter(3, function() hs.screen.mainScreen():shotAsPNG(\"/private/tmp/codex-space-desktop.png\"); local f=io.open(hs.configdir .. \"/desktop-diagnostic.json\",\"w\"); f:write(hs.json.encode({focused=hs.spaces.focusedSpace(),status=spaceNumberStatus})); f:close() end); hs.eventtap.keyStroke({\"ctrl\",\"alt\",\"shift\",\"cmd\"}, \"1\", 0)"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "spaceDiagnosticTimers={}; hs.eventtap.keyStroke({\"ctrl\"}, \"right\", 0); spaceDiagnosticTimers[1]=hs.timer.doAfter(1, function() hs.eventtap.keyStroke({\"ctrl\"}, \"left\", 0) end); spaceDiagnosticTimers[2]=hs.timer.doAfter(4, function() hs.screen.mainScreen():shotAsPNG(\"/private/tmp/codex-native-desktop.png\"); local f=io.open(hs.configdir .. \"/native-desktop-diagnostic.json\",\"w\"); f:write(hs.json.encode({focused=hs.spaces.focusedSpace()})); f:close() end)"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "local s=hs.screen.mainScreen(); local url=s:desktopImageURL(); s:desktopImageURL(url); spaceDiagnosticTimer=hs.timer.doAfter(4, function() s:shotAsPNG(\"/private/tmp/codex-refreshed-desktop.png\") end); print(\"Reloaded existing wallpaper: \" .. url)"], decision="allow")
prefix_rule(pattern=["swift", "-e", "import CoreGraphics; import Foundation; let windows = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] ?? []; for w in windows { print(w[\"kCGWindowOwnerName\"] ?? \"\", w[\"kCGWindowOwnerPID\"] ?? 0, w[\"kCGWindowLayer\"] ?? 0, w[\"kCGWindowBounds\"] ?? \"\") }"], decision="allow")
prefix_rule(pattern=["kill", "-TERM", "643"], decision="allow")
