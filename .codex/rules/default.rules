prefix_rule(pattern=["/opt/homebrew/bin/hs", "-c", "hs.screen.mainScreen():desktopImageURL(\"file:///Users/chenxinyi/Library/Application%20Support/WaifuX/Wallpapers/wallhaven-gpz2g7.jpg\"); spaceDiagnosticTimer=hs.timer.doAfter(3, function() hs.screen.mainScreen():shotAsPNG(\"/private/tmp/codex-space-fullscreen.png\"); local f=io.open(hs.configdir .. \"/fullscreen-diagnostic.json\",\"w\"); f:write(hs.json.encode({focused=hs.spaces.focusedSpace(),status=spaceNumberStatus,wallpaper=hs.screen.mainScreen():desktopImageURL()})); f:close() end); hs.eventtap.keyStroke({\"ctrl\",\"alt\",\"shift\",\"cmd\"}, \"3\", 0)"], decision="allow")
